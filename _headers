# Cloudflare Pages response headers. The VLibras hosts (Libras sign-language widget, loaded only when a
# visitor turns it on in Ajustes) need inline styles, wasm and its frame; its PostHog analytics stays blocked.
# tools/test_build_pages.py checks that every inline <script> on a shipped page has its hash in the CSP below; change one, update the other.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com https://vlibras.gov.br https://cdn.jsdelivr.net/gh/spbgovbr-vlibras/ 'wasm-unsafe-eval' 'sha256-as8V7ma7oSuwoiQbvwvBX6noJLE3Bgmnq733Wuxnv1A='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://vlibras.gov.br https://cdn.jsdelivr.net/gh/spbgovbr-vlibras/; font-src 'self' https://fonts.gstatic.com https://vlibras.gov.br https://cdn.jsdelivr.net/gh/spbgovbr-vlibras/; img-src 'self' data: blob: https://vlibras.gov.br https://cdn.jsdelivr.net/gh/spbgovbr-vlibras/; connect-src 'self' https://cloudflareinsights.com https://vlibras.gov.br https://cdn.jsdelivr.net/gh/spbgovbr-vlibras/ https://traducao2.vlibras.gov.br https://dicionario2.vlibras.gov.br; frame-src https://vlibras.gov.br; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Speculation-Rules: "/speculation-rules.json"

# Prefetch rules (pages load while the pointer rests on a link); browsers require this MIME type.
/speculation-rules.json
  Content-Type: application/speculationrules+json

# Browser games: the Arrumadinho prototype is a single HTML file with inline script and styles;
# Caça-Varal (Vite build) only needs 'self' plus data: images for its item thumbnails.
/jogar/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# BlinkNinja (Godot/WebAssembly): needs wasm compilation, its Supabase backend (scores, login)
# and Google AdSense, which loads from many Google hosts.
/jogar/blinkninja/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://static.cloudflareinsights.com https://pagead2.googlesyndication.com https://*.googlesyndication.com https://*.google.com https://*.gstatic.com https://*.doubleclick.net https://*.adtrafficquality.google; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://iriqkrwtasxjlkkviujs.supabase.co wss://iriqkrwtasxjlkkviujs.supabase.co https://cloudflareinsights.com https://*.googlesyndication.com https://*.google.com https://*.doubleclick.net https://*.adtrafficquality.google; frame-src https://*.googlesyndication.com https://*.doubleclick.net https://*.google.com https://*.adtrafficquality.google; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'

# Sample sites of fictional businesses (modelos/<slug>/): small inline scripts and Google Fonts.
/modelos/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Keep the Pages preview addresses out of search results; 3rstudios.com.br is canonical.
https://3r-studios.pages.dev/*
  X-Robots-Tag: noindex

https://:version.3r-studios.pages.dev/*
  X-Robots-Tag: noindex
